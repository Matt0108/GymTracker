<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="gymtracker-erd" name="GymTracker ERD">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="GymTracker - Entity Relationship Diagram" style="text;html=0;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="570" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="USER&#xa;-------------------------&#xa;UserID (PK)&#xa;FirstName&#xa;LastName&#xa;Email&#xa;Password" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="210" width="300" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="entry" value="EXERCISE_ENTRY&#xa;-------------------------&#xa;ExerciseEntryID (PK)&#xa;UserID (FK)&#xa;ExerciseName&#xa;Weight&#xa;Sets&#xa;Repetitions" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="760" y="190" width="330" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="relationship" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=16;" edge="1" parent="1" source="user" target="entry">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="cardinality" value="One USER may record zero, one, or many EXERCISE_ENTRY records.&#xa;Each EXERCISE_ENTRY must belong to exactly one USER." style="text;html=0;align=center;verticalAlign=middle;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="330" y="540" width="550" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
